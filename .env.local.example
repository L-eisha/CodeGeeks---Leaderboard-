# These are auto-added to your project when you connect an Upstash Redis
# database through the Vercel dashboard (see README.md). For local dev,
# copy this file to .env.local and fill in the values from your Upstash
# database's REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared key for the 2-3 people allowed to edit the leaderboard.
LEADERBOARD_ADMIN_KEY=replace-with-a-private-editor-key
